{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [{ "Name": "Console" }],
    "Enrich": ["FromLogContext"]
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017/?replicaSet=rs0",
    "DatabaseName": "prepstack"
  },
  "Auth": {
    "Jwt": {
      "Issuer": "prepstack",
      "Audience": "prepstack",
      "SigningKey": "",
      "AccessTokenLifetimeMinutes": 15
    },
    "Cookie": {
      "Name": "prepstack_rt",
      "Domain": null
    },
    "RateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "AllowedHosts": "*"
}
